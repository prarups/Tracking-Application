# ==============================================================================
# Django Backend Environment Variables (Production / VPS / Render)
# ==============================================================================

# Database Configuration (PostgreSQL)
# Option A: Full Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/tracking

# Option B: Individual Connection Variables (Used when DATABASE_URL is commented/empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tracking
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False

# Django Secret Key & Debug Mode (Set DEBUG=False on VPS)
SECRET_KEY=django-insecure-enterprise-tracking-secret-key-2026-hyper-secure
DEBUG=False

# Allowed Hostnames & VPS IP (Comma separated)
ALLOWED_HOSTS=*
# Example: ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,123.45.67.89

# CSRF & CORS Trusted Origins (Required for POST requests through Nginx/domain)
# Example: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://123.45.67.89
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=True

# Real-time WebSocket Channel Layer (Set True to run in-memory without Redis)
USE_IN_MEMORY_CHANNELS=True

# Optional: Redis Configuration (If Redis is installed on VPS)
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: Cloudinary Storage (Leave blank to store uploads locally on VPS in media/)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
