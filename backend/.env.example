# ==============================================================================
# Django Backend Environment Variables (Production & Render)
# ==============================================================================

# PostgreSQL Database Connection String (Automatically populated by Render PostgreSQL Blueprint)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tracking

# Django Secret Key (Generate a random 50-character string for production)
SECRET_KEY=django-insecure-enterprise-tracking-secret-key-2026-hyper-secure

# Debug Mode (Must be False in production)
DEBUG=False

# Allowed Hostnames (Comma separated or * for Render)
ALLOWED_HOSTS=*

# Real-time WebSocket Channel Layer (Set True to run without Redis)
USE_IN_MEMORY_CHANNELS=True

# Optional: PostgreSQL Individual Connection Variables (If not using DATABASE_URL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tracking
DB_USER=postgres
DB_PASSWORD=p@ssw0rd
DB_HOST=localhost
DB_PORT=5432

# Optional: Redis Configuration (If Celery / Redis is enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
